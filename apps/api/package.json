{
  "name": "@worktrail/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main.js",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run && vitest run --config vitest.config.e2e.ts",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/with-env.mjs nest start --watch",
    "postinstall": "prisma generate",
    "db:migrate": "node scripts/with-env.mjs prisma migrate dev",
    "db:test:migrate": "node scripts/with-env.mjs --test prisma migrate deploy",
    "db:reset": "node scripts/with-env.mjs prisma migrate reset --force --skip-seed",
    "db:seed": "node scripts/with-env.mjs tsx prisma/seed.ts",
    "worker": "node scripts/with-env.mjs node dist/worker.js",
    "worker:dev": "node scripts/with-env.mjs tsx watch src/worker.ts",
    "pdf:install": "playwright install chromium",
    "ops:erase-company": "node scripts/with-env.mjs tsx scripts/erase-company.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "@sentry/nestjs": "^11.4.0",
    "@worktrail/types": "workspace:*",
    "archiver": "^8.0.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.11",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-cls": "^7.0.1",
    "playwright": "^1.63.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.13",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "adm-zip": "^0.6.1",
    "aws-sdk-client-mock": "^4.1.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "unplugin-swc": "^2.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
