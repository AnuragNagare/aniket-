# ---- api ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://worktrail:worktrail@localhost:5432/worktrail
TEST_DATABASE_URL=postgresql://worktrail:worktrail@localhost:5432/worktrail_test
JWT_ACCESS_SECRET=replace-with-64-random-chars-replace-with-64-random-chars-0000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
WEB_ORIGIN=http://localhost:3000
SEED_ADMIN_PASSWORD=WorkTrail@demo1
# ---- jobs ----
QUEUE_DRIVER=bullmq               # bullmq | inline (inline = no Redis, runs in the API process)
REDIS_URL=redis://localhost:6379
# ---- AI ----
AI_ENABLED=true
GROQ_API_KEY=                     # key from console.groq.com (starts with gsk_)
AI_UPDATE_MODEL=openai/gpt-oss-20b   # must support strict JSON-schema output on Groq
AI_REPORT_MODEL=openai/gpt-oss-120b
# ---- reports ----
REPORT_STORAGE_DIR=./storage/reports   # private; git-ignored
REPORT_TTL_DAYS=30
# ---- Phase 7 hardening, privacy & pilot ----
TRUST_PROXY=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
STORAGE_DRIVER=local               # local | s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
ALLOW_LOCAL_STORAGE=false
RESEND_API_KEY=                    # optional; without it emails are only printed to the API log
MAIL_FROM=Work Trail <no-reply@worktrail.in>
EXPORT_TTL_DAYS=7
RETENTION_RUN_HOUR_IST=2
# ---- web ----
API_URL=http://localhost:4000
# ---- mobile ----
# Address of the computer running the API, as seen from the phone (same Wi-Fi).
# Android emulator: http://10.0.2.2:4000
EXPO_PUBLIC_API_URL=http://192.168.1.108:4000

